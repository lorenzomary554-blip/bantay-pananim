<%- include('partials/header') %>

<!-- ===== PAGE HEADER ===== -->
<div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-8">
  <div>
    <h1 class="text-heading-lg font-extrabold text-charcoal flex items-center gap-3">
      <span aria-hidden="true">📜</span> Sale History
    </h1>
    <p class="text-body-lg text-gray-600 mt-2">A record of all crop sales and dispatches.</p>
  </div>
  <a href="/dispatch" class="btn-dispatch text-xl py-4 px-6 rounded-xl font-bold no-underline flex items-center gap-2 flex-shrink-0">
    <span aria-hidden="true">🚚</span> New Sale
  </a>
</div>

<!-- ===== SUMMARY ===== -->
<div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-8">
  <div class="bg-white rounded-2xl shadow-md border-2 border-green-200 p-6 text-center">
    <span class="text-4xl block mb-2" aria-hidden="true">📊</span>
    <p class="text-display font-extrabold text-forest"><%= Number(totalDispatched).toLocaleString() %></p>
    <p class="text-label font-bold text-gray-700">Total Kilograms Sold</p>
  </div>
  <div class="bg-white rounded-2xl shadow-md border-2 border-blue-200 p-6 text-center">
    <span class="text-4xl block mb-2" aria-hidden="true">🧾</span>
    <p class="text-display font-extrabold text-blue-700"><%= totalTransactions %></p>
    <p class="text-label font-bold text-gray-700">Total Transactions</p>
  </div>
</div>

<!-- ===== LOG TABLE ===== -->
<% if (logs.length === 0) { %>
  <div class="bg-white rounded-2xl shadow-md border-2 border-gray-200 p-10 text-center">
    <span class="text-6xl block mb-4" aria-hidden="true">📭</span>
    <p class="text-heading font-bold text-gray-600">No Sales Yet</p>
    <p class="text-body text-gray-500 mt-2">
      No crops have been sold or dispatched.
      <a href="/dispatch" class="text-forest font-bold underline">Make your first sale</a>
    </p>
  </div>
<% } else { %>
  <div class="space-y-4">
    <% logs.forEach(function(log) { %>
      <div class="bg-white rounded-2xl shadow-sm border-2 border-gray-200 p-5">
        <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4">

          <!-- Sale Info -->
          <div class="flex-1">
            <div class="flex items-center gap-3 mb-2">
              <span class="text-2xl" aria-hidden="true">🧾</span>
              <h3 class="text-xl font-bold text-charcoal"><%= log.crop_name %> — <%= log.bay_code %></h3>
            </div>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-x-6 gap-y-2 text-body">
              <div>
                <span class="text-sm text-gray-500 font-semibold block">Sold</span>
                <span class="font-extrabold text-forest text-lg"><%= log.quantity_dispatched_kg.toLocaleString() %> kg</span>
              </div>
              <div>
                <span class="text-sm text-gray-500 font-semibold block">Date</span>
                <span class="font-bold"><%= log.dispatch_date %></span>
              </div>
              <div>
                <span class="text-sm text-gray-500 font-semibold block">Buyer</span>
                <span class="font-bold"><%= log.buyer_name || 'Not specified' %></span>
              </div>
              <div>
                <span class="text-sm text-gray-500 font-semibold block">Batch Status</span>
                <span class="font-bold
                            <%= log.batch_status === 'Fulfilled' ? 'text-blue-700' : log.batch_status === 'Spoiled' ? 'text-danger' : 'text-charcoal' %>">
                  <%= log.batch_status === 'Fulfilled' ? '✔️ Fully Sold' : log.batch_status %>
                </span>
              </div>
            </div>
            <% if (log.override_reason) { %>
              <div class="mt-3 bg-yellow-50 border border-yellow-300 rounded-lg p-3">
                <p class="text-sm font-bold text-yellow-800">
                  ⚠️ FIFO Override Reason: <span class="font-normal"><%= log.override_reason %></span>
                </p>
              </div>
            <% } %>
          </div>

        </div>
      </div>
    <% }); %>
  </div>
<% } %>

<%- include('partials/footer') %>
